<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chadblincoe.budget-pay-reminder</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/chadblincoe/DesktopFolders/Programs/MyBudgetDash/tools/pay-reminder.sh</string>
    </array>
    <!-- Every day at 9:00 AM (if the Mac is asleep then, it runs on wake) and at every login.
         The script itself stays quiet unless the latest payday is still unanswered. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/budget-pay-reminder.log</string>
</dict>
</plist>
