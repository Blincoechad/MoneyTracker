<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chadblincoe.budget-pay-reminder</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/chadblincoe/DesktopFolders/Programs/MyBudgetDash/tools/pay-reminder.sh</string>
    </array>
    <!-- Every Friday (weekday 5) at 9:00 AM. If the Mac is asleep then, it runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>/tmp/budget-pay-reminder.log</string>
</dict>
</plist>
